{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!next-env.d.ts",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/shared/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/modules",
                      "@/modules/**",
                      "@/integrations",
                      "@/integrations/**",
                      "../..",
                      "../../**"
                    ],
                    "message": "Respect the documented module boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/integrations/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/modules",
                      "@/modules/**",
                      "@/shared/ui",
                      "@/shared/ui/**",
                      "..",
                      "../**"
                    ],
                    "message": "Respect the documented module boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/modules/security/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/modules",
                      "@/modules/**",
                      "@/integrations/**",
                      "@/shared/**",
                      "..",
                      "../**",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "better-auth",
                      "better-auth/**",
                      "pg",
                      "@electric-sql/**",
                      "@vercel/**"
                    ],
                    "message": "The reusable security kernel depends on contracts, not frameworks, providers or vertical modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
