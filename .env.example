# Local prototype: no credentials or external services are required.
# Optional absolute path for the one persistent PostgreSQL data directory.
# Default: .data/landscape inside this repository. Start only one app process.
# LANDSCAPE_DATA_DIR=C:/path/to/neura-landscape/.data/landscape
# Optional: disable Next.js anonymous telemetry for local development.
NEXT_TELEMETRY_DISABLED=1

# Vercel / managed PostgreSQL: configure the real URL as a Secret in Vercel.
# DATABASE_URL=
# Optional initial deployment switch: idempotent SQL under an advisory lock.
# MIGRATE_ON_START=true
# Google Places API (New), server-only. Configure key and quotas before enabling.
# GOOGLE_PLACES_API_KEY=

# Optional fallback; configure the operator under Integraciones in the app.
# Stable A-Z / 0-9 / hyphen identifier used for new LOC codes.
LANDSCAPE_OPERATOR_CODE=

# Private photo storage. Never use a public store for property photos.
# BLOB_STORE_ID=
# Optional legacy token: configure only as a Vercel Secret.
# BLOB_READ_WRITE_TOKEN=
# Native identity: configure shared PostgreSQL, stable URL and a strong session secret.
# APP_AUTH_ENABLED=true enables native email/password; Google is optional.
# No public signup. TI provisions users and private activation/recovery links.
APP_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://stable-approved-host.example
# LANDSCAPE_IT_ADMIN_EMAIL=

# Preview evaluation accounts only; never enable this in Production.
# LANDSCAPE_LOGIN_PREFIX=ROJ
# LANDSCAPE_EVALUATION_USERS=false
# LANDSCAPE_EVALUATION_PASSWORD=

# One-time authorized Preview-only portfolio redistribution; off by default.
# LANDSCAPE_ENTERPRISE_SETUP=false
