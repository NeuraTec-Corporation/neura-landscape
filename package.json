{
  "name": "neura-landscape",
  "version": "0.1.0",
  "description": "NeuraTec Landscape — Experimental Modular AI Operating Platform",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "node scripts/typegen.mjs && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuraTec-Corporation/neura-landscape.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/NeuraTec-Corporation/neura-landscape/issues"
  },
  "homepage": "https://github.com/NeuraTec-Corporation/neura-landscape#readme",
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0"
}
